{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.bar.json",
  "font_family": "JetBrains Mono",
  "font_size": 12,
  "icon_scale": 1.2,
  "padding": 6,
  "widget_spacing": 6,
  "max_label_width": 280,
  "theme": {
    "palette": "Base16",
    "name": "Ashes",
    "accent": "Base0D"
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": false
        },
        "layout": {
          "enable": true
        },
        "focused_window": {
          "enable": true,
          "show_icon": true
        }
      }
    }
  ],
  "right_widgets": [
    { "Update": { "enable": true } },
    { "Storage": { "enable": true } },
    { "Cpu": { "enable": true } },
    { "Memory": { "enable": true } },
    { "Network": { "enable": true, "show_activity": true, "show_total_activity": false } },
    { "Battery": { "enable": true } },
    { "Date": { "enable": true, "format": { "Custom": "%a %d %b" } } },
    { "Time": { "enable": true, "format": "TwentyFourHour" } }
  ]
}
